# slack bot creds & posting channel id
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# set to false to disable the automatic daily post while keeping manual posts and /memes enabled
DAILY_POST_ENABLED=true
# daily scheduled post time (in UTC), when enabled
DAILY_POST_TIME=00:00

# /memes cooldown times
# set either value to 0 to disable that limit
MEME_COMMAND_CHANNEL_COOLDOWN_SECONDS=300 # per each channel, applies to any user using the cmd in that channel
MEME_COMMAND_USER_COOLDOWN_SECONDS=60 # per each user, anywhere the user uses the command
# comma-separated channel IDs that skip the channel cooldown; the user cooldown still applies however
MEME_COMMAND_CHANNEL_COOLDOWN_EXEMPT_IDS=

# optional logging and LLM moderation settings
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL
LLM_ENABLED=false # if LLM use is enabled or not
# When LLM_ENABLED=true, set either path-specific control to false to skip LLM moderation there.
LLM_MEMES_COMMAND_MODERATION_ENABLED=true # if the /memes command should be moderated by the LLM; automatically disabled if LLM_ENABLED=false
LLM_DAILY_POST_MODERATION_ENABLED=true # if the daily post should be moderated by the LLM; automatically disabled if LLM_ENABLED=false
LLM_MODEL= # model you want to use, duh
# 'openai', 'anthropic', or 'gemini' (not the actual company's models for openai and anthropic,
# but instead the api specification that was made by openai or anthropic
# you can use custom models with these, depending on api support
# gemini is the only provider that cannot be used with custom models,
# therefore you can't use it unless its on gemini's own api
# see https://ai.gemini.dev/api if you need more details on that
LLM_PROVIDER= # ^^
# optional custom endpoint for openai or anthropic; omit it to use the provider's default endpoint (below)
LLM_ENDPOINT=
LLM_API_KEY= # override the LLM_API_KEY_ENV variable if you want to put it directly in this file
LLM_API_KEY_ENV= # environment variable you want to use for the LLM API key, if you don't want to put it directly in this file
LLM_MAX_TOKENS=4096 # max output tokens for LLM responses
LLM_TIMEOUT_SECONDS=60 # positive request timeout in seconds for provider calls
LLM_MODERATION_STRICTNESS=high # lenient, high, balanced, strict
